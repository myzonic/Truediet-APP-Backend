# Server Port & URL
PORT=3000
BETTER_AUTH_URL=http://localhost:3000

# Better Auth Secret (Min 32 random characters)
# Can generate via terminal: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_long_secret_here_for_encryption

# PostgreSQL Connection String
# In Local Dev: postgresql://postgres:password@localhost:5432/truediet
# In Dokploy (Internal Network): postgresql://<user>:<password>@<postgres-service-name>:5432/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5432/truediet

# Allowed Frontend / App Origins for CORS
TRUSTED_ORIGINS=http://localhost:8081,exp://*,truediet://*

# Optional Google OAuth (Leave empty until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cal.com scheduling API (Telehealth booking) - server-side only, never sent
# to the mobile app.
CAL_API_KEY=
# Preferred API base. CAL_API_URL below is the legacy name and is still read
# if this one is empty. Never hardcode a different base per environment.
CAL_API_BASE_URL=https://api.cal.com/v2
CAL_API_URL=https://api.cal.com/v2
# Consultation event types. PHONE falls back to the video id when empty, so a
# single configured event covers both consultation formats.
CAL_EVENT_TYPE_ID=
CAL_EVENT_TYPE_ID_PHONE=
CAL_USERNAME=
# Optional public booking page the app can open.
CAL_BOOKING_URL=
# Signs inbound Cal.com webhooks (X-Cal-Signature-256, HMAC-SHA256 of the
# raw body). Set to match the signing secret saved on the Cal.com webhook.
CAL_WEBHOOK_SECRET=

# Stream Video API (in-app telehealth calls)
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_APP_ID=

# Expo Push access token (optional - only needed for server-side sending)
EXPO_ACCESS_TOKEN=

# Transactional auth email (password reset + email verification).
# Real values live in the ignored local .env or in Dokploy environment
# variables - never commit them.
#
# Hostinger Titan, non-EU outgoing server, implicit TLS:
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@true-diet.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=TrueDiet <noreply@true-diet.com>

# Test transport: "json" renders each message without opening a socket, so
# no email is ever sent. Leave unset for real SMTP delivery.
EMAIL_TRANSPORT=

# Set to "true" only after the verification flow has been tested and approved.
# Off means: no verification email on sign-up, and sign-in never requires it.
EMAIL_VERIFICATION_ENABLED=false
# Staff access for the dietitian chat (page at /staff, header x-dietitian-key
# on /api/messages). Generate one, e.g.: openssl rand -hex 32
# Leave empty to disable staff access (requests with the header get 503).
DIETITIAN_API_KEY=
